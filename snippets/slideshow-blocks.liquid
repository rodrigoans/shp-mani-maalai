{% comment %}
  ATOMS: SLIDE VIDEO
  Added video slide option to slideshow blocks on schema.
{% endcomment %}

{% for block in blocks %}
  {%- liquid
    assign desktop_image = block.settings.image
    assign background_video_url = block.settings.video
    assign slide_class_modifiers = ''
    assign align = block.settings.alignment | split: "_"
    assign text_container_color = block.settings.text_container_color
    assign background = true
    if text_container_color == blank or text_container_color == 'rgba(0,0,0,0)'
      assign background = false
    endif

    assign disable_image_style = true

    if image_aspect == 'original'
      assign disable_image_style = false
    endif

    assign slide_class_modifiers = slide_class_modifiers | append: ' slideshow__slide--aspect-' | append: image_aspect

    if desktop_image != blank
      assign slide_class_modifiers = slide_class_modifiers | append: ' slideshow__slide--has-image'
    endif

    if background_video_url != blank
      assign slide_class_modifiers = slide_class_modifiers | append: ' slideshow__slide--has-video'
    endif

    if block.settings.mobile_image != blank
      assign slide_class_modifiers = slide_class_modifiers | append: ' slideshow__slide--has-mobile-image'
    endif

    assign brightness_button = block.settings.color_background_button | color_brightness
    if brightness_button > 60
      assign color_background_button_hover = block.settings.color_background_button | color_darken: 20
      else
      assign color_background_button_hover = block.settings.color_background_button | color_lighten: 20
    endif
  -%}

  {% capture slide_attributes %}
    class="slideshow__slide{{ slide_class_modifiers }}"
    {{ block.shopify_attributes }}
    data-index="{{ forloop.index0 }}"
    style="
      --overlay-background: {{ block.settings.overlay_color }};
      {% if block.settings.color_overlay_gradient != blank %}
        --overlay-gradient: {{ block.settings.color_overlay_gradient }};
      {% endif %}
      --text-container-background: {{ block.settings.text_container_color }};
      --content-color: {{ block.settings.text_color }};
      --heading-font-size: {{ block.settings.heading_text_size }}px;
      --subheading-font-size: {{ block.settings.subheading_text_size }}px;
      --heading-max-width: {{ block.settings.heading_max_width }}rem;
      --text-max-width: {{ block.settings.text_max_width }}rem;
      --button-text-color: {{ block.settings.color_text_button }};
      --button-text-background: {{ block.settings.color_background_button }};
      --button-text-background-hover: {{ color_background_button_hover }};
    "
  {% endcapture %}

  {%- if block.settings.link_text == blank and block.settings.link != blank -%}
    <a href="{{ block.settings.link }}" {{ slide_attributes }}>
  {%- else -%}
    <div {{ slide_attributes }}>
  {%- endif -%}

    {% if desktop_image == blank and background_video_url == blank %}
      {% capture current %}{% cycle 1, 2 %}{% endcapture %}
      <div class="slideshow__placeholder slideshow__image slideshow__image--desktop slideshow__image--mobile{% unless image_is_constrained %} slideshow__image--unconstrained{% endunless %}">{{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg image__img' }}</div>
    {% endif %}

    <div class="slideshow__overlay o-{{ block.settings.overlay_opacity }}"></div>

    <div class="slideshow__content-wrap slideshow__content-wrap--{{ align[1] }}">
      <div class="slideshow__content {% if block.settings.link_secondary != blank and block.settings.link_text_secondary != blank %} slideshow__content-inner-container--has-secondary-button{% endif %}">
        <div class="slideshow__content-inner slideshow__content-inner--{{ align[0] }}">
          <div class="slideshow__content-inner-container {% if background %}slideshow__content-inner-container--has-background{% endif %}">
          {% if block.settings.overline != blank %}
            <h2
              class="slideshow__overline overline"
              data-theme-editor-setting="section.{{ id }}.block.{{ block.id }}.overline"
            >
              {{ block.settings.overline }}
            </h2>
          {% endif %}
          {% if block.settings.title != blank %}
            <h2
              class="slideshow__heading type-heading-dynamic"
              data-theme-editor-setting="section.{{ id }}.block.{{ block.id }}.title"
            >
              {{ block.settings.title }}
            </h2>
          {% endif %}
          {% if block.settings.subheading != blank %}
            <div
              class="slideshow__subheading type-body-regular"
              data-theme-editor-setting="section.{{ id }}.block.{{ block.id }}.subheading"
            >
              {{ block.settings.subheading }}
            </div>
          {% endif %}
          {% comment %}
            ATOMS: SLIDE BUTTONS
          {% endcomment %}
          <div class="slideshow__buttons">
            {%- if block.settings.link != blank and block.settings.link_text != blank -%}
              <a href="{{ block.settings.link }}" class="slideshow__link bttn bttn--inline {{ horizontal_position }}">{{ block.settings.link_text }}</a>
            {%- endif -%}
             {%- if block.settings.link_secondary != blank and block.settings.link_text_secondary != blank -%}
              <a href="{{ block.settings.link_secondary }}" class="slideshow__link bttn bttn--inline {{ horizontal_position }}">{{ block.settings.link_text_secondary }}</a>
             {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>

    

    {% if background_video_url != blank %}
      {%- liquid
        assign video_wrapper_class = 'slideshow__image slideshow__image--desktop slideshow__image--mobile'
        assign video_wrapper_class = video_wrapper_class | append: ' slideshow__image--aspect-' | append: image_aspect

        assign embed_url = ''
        assign youtube_id = ''

        if background_video_url contains 'youtube.com/watch'
          assign youtube_id = background_video_url | split: 'v=' | last | split: '&' | first
        elsif background_video_url contains 'youtu.be/'
          assign youtube_id = background_video_url | split: 'youtu.be/' | last | split: '?' | first
        elsif background_video_url contains 'youtube.com/embed/'
          assign youtube_id = background_video_url | split: 'youtube.com/embed/' | last | split: '?' | first
        endif

        if youtube_id != blank
          assign embed_url = 'https://www.youtube.com/embed/' | append: youtube_id | append: '?autoplay=1&mute=1&loop=1&playlist=' | append: youtube_id | append: '&controls=0&rel=0&modestbranding=1&playsinline=1'
        elsif background_video_url contains 'vimeo.com/'
          assign vimeo_id = background_video_url | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | last
          if vimeo_id != blank
            assign embed_url = 'https://player.vimeo.com/video/' | append: vimeo_id | append: '?autoplay=1&muted=1&loop=1&background=1'
          endif
        endif
      -%}

      <div class="{{ video_wrapper_class }} slideshow__video-wrap">
        {% if embed_url != blank %}
          <iframe
            class="slideshow__video"
            src="{{ embed_url }}"
            title="Background video"
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            loading="lazy"
            style="width:100%;height:100%;"
          ></iframe>
        {% else %}
          <video class="slideshow__video" autoplay muted loop playsinline style="width:100%;height:100%;object-fit:cover;">
            <source src="{{ background_video_url }}">
          </video>
        {% endif %}
      </div>
    {% elsif desktop_image != blank %}
      {%- liquid
        assign image_wrapper_class = 'slideshow__image slideshow__image--desktop'
        assign image_wrapper_class = image_wrapper_class | append: ' slideshow__image--aspect-' | append: image_aspect
      -%}

      {% render 'image',
        image: desktop_image,
        wrapper_class: image_wrapper_class,
        disable_style: disable_image_style,
        focal_point: block.settings.focal_point,
        max_width: 3000,
        animate: true
      %}
    {% endif %}

    {% if background_video_url == blank and block.settings.mobile_image != blank %}
      {%- liquid
        assign mobile_image_wrapper_class = 'slideshow__image slideshow__image--mobile'
        assign mobile_image_wrapper_class = mobile_image_wrapper_class | append: ' slideshow__image--aspect-' | append: image_aspect
      -%}

      {% render 'image',
        image: block.settings.mobile_image,
        wrapper_class: mobile_image_wrapper_class,
        disable_style: disable_image_style,
        focal_point: block.settings.mobile_focal_point,
        max_width: 3000,
        animate: true
      %}
    {% endif %}


  {%- if block.settings.link_text == blank and block.settings.link != blank -%}
    </a>
  {%- else -%}
    </div>
  {%- endif -%}

{% endfor %}
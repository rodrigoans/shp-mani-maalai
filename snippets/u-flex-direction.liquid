{% style %}

.u-flex-row {
    flex-direction: row;
}
.u-flex-row-reverse {
    flex-direction: row-reverse;
}
.u-flex-col {
    flex-direction: column;
}
.u-flex-col-reverse {
    flex-direction: column-reverse;
}

@media (min-width: 1024px) {
    .lg\:u-flex-row {
        flex-direction: row;
    }
    .lg\:u-flex-row-reverse {
        flex-direction: row-reverse;
    }
    .lg\:u-flex-col {
        flex-direction: column;
    }
    .lg\:u-flex-col-reverse {
        flex-direction: column-reverse;
    }
}

{% endstyle %}
{% style %}

.u-flex-wrap {
    flex-wrap: wrap;
}
.u-flex-wrap-reverse {
    flex-wrap: wrap-reverse;
}
.u-flex-nowrap {
    flex-wrap: nowrap;
}

@media (min-width: 1024px) {
    .lg\:u-flex-wrap {
        flex-wrap: wrap;
    }
    .lg\:u-flex-wrap-reverse {
        flex-wrap: wrap-reverse;
    }
    .lg\:u-flex-nowrap {
        flex-wrap: nowrap;
    }
}

{% endstyle %}